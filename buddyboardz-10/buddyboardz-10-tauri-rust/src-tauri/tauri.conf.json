{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuddyBoardz 10",
  "version": "1.0.0",
  "identifier": "in.surat.buddyboardz10",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BuddyBoardz 10",
        "width": 1160,
        "height": 760,
        "minWidth": 420,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "../Assets/**", "./icons/**"]
      }
    }
  }
}
